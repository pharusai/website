---

<section id="features" class="bg-pharus-light py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold">
        Pick the modules you need
      </h2>
      <p class="mt-4 text-lg text-pharus-gray">
        Pharus is built around independent, composable modules. Start with what matters most and expand as your operations grow.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-pharus-blue/10 to-pharus-purple/10 flex items-center justify-center text-pharus-blue mb-4">
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="text-lg font-semibold mb-2">{feature.title}</h3>
          <p class="text-pharus-gray text-sm leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
